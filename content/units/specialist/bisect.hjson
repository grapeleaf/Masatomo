segmentScl: 4
segmentPhase: 5
segmentMag: 1


//Weapon
weapons: [
    {
        reload: 1
        shootOnDeath: true
        shootCone: 360
        shake: 3

        controllable: false
        aiControllable: false

        bullet: {
