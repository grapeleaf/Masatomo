            fragVelocityMin: 1
            fragVelocityMax: 1
            fragBullet: {
                type: BasicBulletType
                damage: 15
                speed: 8

                pierce: true
                pierceBuilding: true
                pierceCap: 3
                pierceDamageFactor: 0.5

                hitSize: 6
