localizedName: "Ferronickel Forge"
description: "Flash smelts hematite and nickel into ferronickel using oxygen"

//Stat
type: GenericCrafter
size: 3
requirements: [
    hematite/120
    nickel/75
    silicon/35
]
consumes: {
    power: 4
    items: [
        hematite/3
        nickel/2
    ]
    liquid: oxygen-gas/0.05
}
outputItem: ferronickel/5

craftTime: 75

