localizedName: "Ferronickel Forge"
description: "Smelts hematite and nickel into ferronickel.\nRequires power and heat."

//Stat
size: 3
heatRequirement: 12
requirements: [
    hematite/150
    nickel/150
    msilicon/100
]
consumes: {
    power: 3
    items: [
        hematite/3
        nickel/3
    ]
}
outputItem: ferronickel/6

craftTime: 75

//Visual
squareSprite: false
ambientSound: loopSmelter
ambientSoundVolume: 0.8

craftEffect: [
    {
        type: RadialEffect
        effect: surgeCruciSmoke
        amount: 8
        rotationSpacing: 45
        lengthOffset: 5.5
    }
]
drawer: {
  type: DrawMulti
  drawers: [
    {
        type: DrawRegion
        suffix: "-bottom"
    }
    {
        type: DrawBlurSpin
        suffix: "-rotator"
        rotateSpeed: 10
        blurThresh: 0.03
    }
    {
        type: DrawDefault
    }
    {
        type: DrawGlowRegion
        suffix: "-glow"
        color: ff9a55
    }
  ]
}

//Tech Tree
//alwaysUnlocked: true

category: crafting
research: {
    parent: silicon-arc-dissolver
    objectives: [
        {
            type: OnSector
            preset: march
        }
    ]
}
researchCost: [
    hematite/200
    nickel/225
    msilicon/175
]