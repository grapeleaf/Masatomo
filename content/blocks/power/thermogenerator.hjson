drawer: {
  type: DrawMulti
  drawers: [
    {
        type: DrawDefault
    }
    {
        type: DrawBlurSpin
        suffix: "-rotator"
        rotateSpeed: 10
        blurThresh: 0.03
    }
    {
        type: DrawRegion
        suffix: "-top"
    }
  ]
}

